{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrition-tracker-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutrition-tracker",
      "database_id": "replace-after-d1-create",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
